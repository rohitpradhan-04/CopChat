# Database Configuration
DATABASE_URL="postgresql://username:password@localhost:5432/copchat_db"

# SMTP Email Configuration (Paste your SMTP credentials here)
SMTP_HOST="smtp.gmail.com"
SMTP_PORT=587
SMTP_USER="your-email@gmail.com"
SMTP_PASSWORD="your-app-password-or-smtp-key"
SMTP_FROM_EMAIL="noreply@copchat.com"
SMTP_FROM_NAME="CopChat Portal Admin"
SMTP_USE_TLS=true
SMTP_USE_SSL=false

# Security & Token Settings
JWT_SECRET_KEY="your-super-secret-jwt-key-please-change-in-production"
JWT_ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=1440
